# Managed by Ansible — G7 DB verification lane (staging only).
# Complements deploy/compose/.env: this drives deploy/db/compose.g7.yaml
# (its own disposable postgres + db-tools). grant-runtime.sh is HELD and is
# intentionally NOT executed by the migrate playbook.
APPTS_DB_NETWORK_MODE={{ appts_db_network_mode }}
APPTS_STAGING_LABEL={{ appts_staging_label }}
APPTS_DISPOSABLE_DATABASE={{ appts_disposable_database }}
APPTS_DB_NAME={{ appts_postgres_db }}
APPTS_ADMIN_DB={{ appts_admin_db }}
APPTS_ADMIN_USER={{ appts_admin_user }}
APPTS_ADMIN_PASSWORD={{ appts_admin_password }}
APPTS_MIGRATION_ROLE={{ appts_migration_role }}
APPTS_MIGRATION_PASSWORD={{ appts_migration_password }}
APPTS_RUNTIME_ROLE={{ appts_runtime_role }}
APPTS_RUNTIME_PASSWORD={{ appts_runtime_password }}
APPTS_BACKUP_FILE={{ appts_backup_file }}
APPTS_RESTORE_CONFIRM=RESTORE-BASED ROLLBACK
PGPORT={{ appts_db_port }}
