# Gate C: Linux x64 non-container staging — systemd unit (MCR-to-BUILDER-008 §2.C)
# Staging evidence target: systemctl status, journalctl output, ps output.
#
# Prerequisites (on the Linux x64 staging machine):
#   1. Node.js 24.19.0 installed at /usr/local/bin/node
#   2. DEP-001 built artifacts extracted to /opt/appts-restore-service/
#      (copy apps/api/dist, apps/web/dist, packages/*/dist, node_modules from build)
#   3. EnvironmentFile populated at /etc/appts-restore-service/appts-restore-api.env
#   4. System user 'appts' created: useradd --system --no-create-home appts
#
# EnvironmentFile /etc/appts-restore-service/appts-restore-api.env must contain:
#   APPTS_STAGING_LABEL=STAGING SIMULATION / NON-PRODUCTION
#   API_LISTEN_PORT=8080
#   APPTS_RUNTIME_DATABASE_URL=postgresql://<runtime_role>:<password>@<host>:<port>/<db>
#   DATABASE_URL=postgresql://<runtime_role>:<password>@<host>:<port>/<db>
#   NODE_ENV=production
#
# Install:
#   sudo cp deploy/systemd/appts-restore-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now appts-restore-api
#
# Evidence capture:
#   systemctl status appts-restore-api
#   journalctl -u appts-restore-api --since "5 minutes ago"
#   ps -fp $(systemctl show -p MainPID --value appts-restore-api)

[Unit]
Description=appts-restore-service API (DEP-001 staging)
After=network.target

[Service]
Type=simple
User=appts
Group=appts
WorkingDirectory=/opt/appts-restore-service
EnvironmentFile=/etc/appts-restore-service/appts-restore-api.env
ExecStart=/usr/local/bin/node /opt/appts-restore-service/apps/api/dist/dep-bootstrap.js
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=appts-restore-api

[Install]
WantedBy=multi-user.target
