# Externalized staging configuration names only.
# Values must be supplied by the staging host; no value or secret is packaged here.
# This template is not an executed evidence record.

# Common staging guard:
# APPTS_DB_NETWORK_MODE
# APPTS_SCHEMA_FREEZE_MAINTAINER_AUTH (maintainer-only baseline tooling; never operational; exact sentinel required)
# APPTS_STAGING_LABEL
# APPTS_DISPOSABLE_DATABASE
# PGHOST
# PGPORT
# APPTS_DB_NAME

# Database bootstrap (admin connection and role creation):
# APPTS_ADMIN_DB
# APPTS_ADMIN_USER
# APPTS_ADMIN_PASSWORD
# APPTS_MIGRATION_ROLE
# APPTS_MIGRATION_PASSWORD
# APPTS_RUNTIME_ROLE
# APPTS_RUNTIME_PASSWORD

# Migration and runtime/grant connection:
# PGDATABASE
# PGUSER
# PGPASSWORD

# Checkpoint backup:
# APPTS_BACKUP_FILE

# Restore-based rollback confirmation:
# APPTS_RESTORE_CONFIRM
