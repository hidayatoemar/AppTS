FROM node:24.19.0-bookworm-slim AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/adapters-d05/package.json packages/adapters-d05/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/core-d01/package.json packages/core-d01/package.json
COPY packages/core-d02/package.json packages/core-d02/package.json
COPY packages/core-d03/package.json packages/core-d03/package.json
COPY packages/diagnostics/package.json packages/diagnostics/package.json
COPY packages/interaction-d06/package.json packages/interaction-d06/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/persistence/package.json packages/persistence/package.json
COPY packages/runtime-d04/package.json packages/runtime-d04/package.json
COPY packages/test-support/package.json packages/test-support/package.json

RUN npm ci --ignore-scripts --no-audit --no-fund

COPY tsconfig.base.json ./
COPY apps/api apps/api
COPY apps/web apps/web
COPY packages/config packages/config
COPY packages/contracts packages/contracts
COPY packages/core-d01 packages/core-d01
COPY packages/observability packages/observability

RUN npm run build:dep --workspace=apps/api
RUN npm run build --workspace=apps/web

FROM node:24.19.0-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
EXPOSE 8080

# Keep only workspace metadata needed for the production dependency install;
# application and package source are copied below as compiled artifacts only.
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/adapters-d05/package.json packages/adapters-d05/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/core-d01/package.json packages/core-d01/package.json
COPY packages/core-d02/package.json packages/core-d02/package.json
COPY packages/core-d03/package.json packages/core-d03/package.json
COPY packages/diagnostics/package.json packages/diagnostics/package.json
COPY packages/interaction-d06/package.json packages/interaction-d06/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/persistence/package.json packages/persistence/package.json
COPY packages/runtime-d04/package.json packages/runtime-d04/package.json
COPY packages/test-support/package.json packages/test-support/package.json
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

COPY --from=build /workspace/apps/api/dist ./apps/api/dist
COPY --from=build /workspace/apps/web/dist ./apps/web/dist
COPY --from=build /workspace/packages/config/dist ./packages/config/dist
COPY --from=build /workspace/packages/core-d01/dist ./packages/core-d01/dist
COPY --from=build /workspace/packages/observability/dist ./packages/observability/dist
COPY deploy/compose/entrypoint.sh /usr/local/bin/dep-entrypoint
COPY deploy/compose/entrypoint.g6-crash-once.test.sh /usr/local/lib/dep/entrypoint.g6-crash-once.test.sh
RUN chmod 0555 /usr/local/bin/dep-entrypoint
RUN chmod 0555 /usr/local/lib/dep/entrypoint.g6-crash-once.test.sh

ENTRYPOINT ["/usr/local/bin/dep-entrypoint"]
